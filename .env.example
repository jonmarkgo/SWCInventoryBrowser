# SWC OAuth Application Credentials
# Register at: https://www.swcombine.com/ws/oauth2/applications/
SWC_CLIENT_ID=your_client_id_here
SWC_CLIENT_SECRET=your_client_secret_here

# Optional: Override the OAuth redirect URI (must match what's registered with SWC)
# If not set, defaults to {BASE_URL}/auth/callback
# SWC_REDIRECT_URI=https://yourdomain.com/oauth/callback

# App Configuration
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change_this_to_a_random_string

# Database file path (relative to project root)
DB_PATH=./data/inventory.db

# Limit inventory fetch to N items per entity type (0 = no limit, fetch all)
# Useful for testing with large inventories
# INVENTORY_FETCH_LIMIT=100
