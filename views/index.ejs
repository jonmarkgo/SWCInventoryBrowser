<% layout('layout') -%>

<div class="d-flex flex-column align-items-center justify-content-center min-vh-75 text-center">
  <div class="mb-4">
    <i class="bi bi-box-seam display-1 text-info"></i>
  </div>
  <h1 class="display-5 fw-bold mb-2">Inventory Control</h1>
  <p class="text-secondary mb-4 col-md-6">
    Manage your faction's inventory with virtual groups, delegated access, and full audit trails.
    All operations execute through the faction leader's authorized API connection.
  </p>

  <div class="d-flex gap-3 flex-wrap justify-content-center">
    <a href="/auth/login?role=leader" class="btn btn-info btn-lg px-4">
      <i class="bi bi-shield-lock"></i> Faction Leader Login
    </a>
    <a href="/auth/login?role=subuser" class="btn btn-outline-light btn-lg px-4">
      <i class="bi bi-person"></i> Sub-user Login
    </a>
  </div>

  <div class="mt-5 text-secondary small">
    <p class="mb-1">Authenticate via Star Wars Combine OAuth</p>
    <p class="text-muted">Leader login required first to enable inventory access</p>
  </div>
</div>
