<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/users" class="text-info">Users</a></li>
    <li class="breadcrumb-item active"><%= targetUser.swc_name %></li>
  </ol>
</nav>

<h2 class="mb-1"><i class="bi bi-key text-info"></i> Permissions: <%= targetUser.swc_name %></h2>
<p class="text-muted mb-4">SWC UID: <%= targetUser.swc_uid %></p>

<% if (groups.length === 0) { %>
  <div class="text-center text-muted py-5">
    <p>No groups exist yet. <a href="/groups" class="text-info">Create a group</a> first.</p>
  </div>
<% } else { %>
  <form method="POST" action="/users/<%= targetUser.id %>/permissions">
    <div class="table-responsive">
      <table class="table table-dark align-middle">
        <thead>
          <tr>
            <th>Group</th>
            <th class="text-center">View</th>
            <th class="text-center">Assign</th>
            <th class="text-center">Rename</th>
            <th class="text-center">Makeover</th>
            <th class="text-center">Tag</th>
          </tr>
        </thead>
        <tbody>
          <% groups.forEach(g => { %>
            <% const perm = permMap[g.id] || {}; %>
            <tr>
              <td><%= g.name %></td>
              <td class="text-center">
                <input type="checkbox" class="form-check-input" name="perms[g<%= g.id %>][can_view]" value="1" <%= perm.can_view ? 'checked' : '' %>>
              </td>
              <td class="text-center">
                <input type="checkbox" class="form-check-input" name="perms[g<%= g.id %>][can_assign]" value="1" <%= perm.can_assign ? 'checked' : '' %>>
              </td>
              <td class="text-center">
                <input type="checkbox" class="form-check-input" name="perms[g<%= g.id %>][can_rename]" value="1" <%= perm.can_rename ? 'checked' : '' %>>
              </td>
              <td class="text-center">
                <input type="checkbox" class="form-check-input" name="perms[g<%= g.id %>][can_makeover]" value="1" <%= perm.can_makeover ? 'checked' : '' %>>
              </td>
              <td class="text-center">
                <input type="checkbox" class="form-check-input" name="perms[g<%= g.id %>][can_tag]" value="1" <%= perm.can_tag ? 'checked' : '' %>>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <button type="submit" class="btn btn-info"><i class="bi bi-check-lg"></i> Save Permissions</button>
  </form>
<% } %>
