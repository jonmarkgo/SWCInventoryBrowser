<div class="d-flex justify-content-between align-items-center mb-4">
  <h2><i class="bi bi-people text-info"></i> Sub-users</h2>
</div>

<p class="text-muted mb-4">
  Users appear here after they log in via SWC OAuth. Assign group permissions to grant them access to manage specific inventory groups.
</p>

<% if (users.length === 0) { %>
  <div class="text-center text-muted py-5">
    <i class="bi bi-people display-4"></i>
    <p class="mt-2">No sub-users have logged in yet. Share the login link with faction members.</p>
  </div>
<% } else { %>
  <div class="table-responsive">
    <table class="table table-dark table-hover align-middle">
      <thead>
        <tr>
          <th>SWC Name</th>
          <th>SWC UID</th>
          <th>Groups</th>
          <th>Joined</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(u => { %>
          <tr>
            <td><%= u.swc_name %></td>
            <td class="text-muted small"><%= u.swc_uid %></td>
            <td>
              <% const userPerms = permsByUser[u.id] || []; %>
              <% userPerms.forEach(p => { %>
                <span class="badge bg-secondary"><%= p.group_name %></span>
              <% }) %>
              <% if (userPerms.length === 0) { %>
                <span class="text-muted small">None</span>
              <% } %>
            </td>
            <td class="text-muted small"><%= new Date(u.created_at).toLocaleDateString() %></td>
            <td class="text-end">
              <a href="/users/<%= u.id %>" class="btn btn-sm btn-outline-info">
                <i class="bi bi-key"></i> Permissions
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
