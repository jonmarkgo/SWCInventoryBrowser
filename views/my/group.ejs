<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/my/dashboard" class="text-info">My Dashboard</a></li>
    <li class="breadcrumb-item active"><%= group.name %></li>
  </ol>
</nav>

<h2 class="mb-1"><i class="bi bi-collection text-info"></i> <%= group.name %></h2>
<% if (group.description) { %>
  <p class="text-muted mb-3"><%= group.description %></p>
<% } %>

<div class="d-flex flex-wrap gap-1 mb-4">
  <span class="text-muted small me-2">Your permissions:</span>
  <% if (perms.can_assign) { %><span class="badge bg-info bg-opacity-25 text-info">Assign</span><% } %>
  <% if (perms.can_rename) { %><span class="badge bg-info bg-opacity-25 text-info">Rename</span><% } %>
  <% if (perms.can_makeover) { %><span class="badge bg-info bg-opacity-25 text-info">Makeover</span><% } %>
  <% if (perms.can_tag) { %><span class="badge bg-info bg-opacity-25 text-info">Tag</span><% } %>
</div>

<% if (items.length === 0) { %>
  <div class="text-center text-muted py-5">
    <i class="bi bi-inbox display-4"></i>
    <p class="mt-2">No items in this group.</p>
  </div>
<% } else { %>
  <div class="table-responsive">
    <table class="table table-dark table-hover align-middle" id="group-table">
      <thead>
        <tr>
          <% if (perms.can_assign || perms.can_rename || perms.can_makeover || perms.can_tag) { %>
            <th style="width:40px;">
              <input type="checkbox" class="form-check-input" id="select-all-group">
            </th>
          <% } %>
          <th style="width:40px;"></th>
          <th>Name</th>
          <th>Type</th>
          <th>UID</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(item => { %>
          <tr>
            <% if (perms.can_assign || perms.can_rename || perms.can_makeover || perms.can_tag) { %>
              <td>
                <input type="checkbox" class="form-check-input bulk-select"
                       data-entity-type="<%= item.entity_type %>"
                       data-entity-uid="<%= item.entity_uid %>"
                       data-entity-name="<%= item.entity_name %>">
              </td>
            <% } %>
            <td>
              <% if (item.entity_image) { %>
                <img src="<%= item.entity_image %>" alt="" class="rounded" style="width:32px; height:32px; object-fit:cover;">
              <% } else { %>
                <i class="bi bi-box text-muted"></i>
              <% } %>
            </td>
            <td><%= item.entity_name || 'Unnamed' %></td>
            <td class="text-capitalize text-muted"><%= item.entity_type %></td>
            <td class="text-muted small"><%= item.entity_uid %></td>
            <td class="text-end">
              <div class="d-flex gap-1 justify-content-end">
                <% if (perms.can_assign) { %>
                  <button class="btn btn-sm btn-outline-warning action-btn"
                          data-action="assign"
                          data-entity-type="<%= item.entity_type %>"
                          data-entity-uid="<%= item.entity_uid %>"
                          data-entity-name="<%= item.entity_name %>"
                          data-bs-toggle="modal" data-bs-target="#actionModal">
                    <i class="bi bi-arrow-right-circle"></i> Assign
                  </button>
                <% } %>
                <% if (perms.can_rename) { %>
                  <button class="btn btn-sm btn-outline-info action-btn"
                          data-action="rename"
                          data-entity-type="<%= item.entity_type %>"
                          data-entity-uid="<%= item.entity_uid %>"
                          data-entity-name="<%= item.entity_name %>"
                          data-bs-toggle="modal" data-bs-target="#actionModal">
                    <i class="bi bi-pencil"></i> Rename
                  </button>
                <% } %>
                <% if (perms.can_makeover) { %>
                  <button class="btn btn-sm btn-outline-success action-btn"
                          data-action="makeover"
                          data-entity-type="<%= item.entity_type %>"
                          data-entity-uid="<%= item.entity_uid %>"
                          data-entity-name="<%= item.entity_name %>"
                          data-bs-toggle="modal" data-bs-target="#actionModal">
                    <i class="bi bi-brush"></i> Makeover
                  </button>
                <% } %>
                <% if (perms.can_tag) { %>
                  <button class="btn btn-sm btn-outline-light action-btn"
                          data-action="tag"
                          data-entity-type="<%= item.entity_type %>"
                          data-entity-uid="<%= item.entity_uid %>"
                          data-entity-name="<%= item.entity_name %>"
                          data-bs-toggle="modal" data-bs-target="#actionModal">
                    <i class="bi bi-tag"></i> Tag
                  </button>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<!-- Bulk Action Bar -->
<div class="bulk-action-bar" id="bulk-action-bar" style="display:none;">
  <div class="container-fluid d-flex align-items-center justify-content-between">
    <span><strong id="bulk-count">0</strong> items selected</span>
    <div class="d-flex gap-2">
      <% if (perms.can_assign) { %>
        <button class="btn btn-sm btn-outline-warning bulk-action-trigger" data-action="assign"
                data-bs-toggle="modal" data-bs-target="#bulkActionModal">
          <i class="bi bi-arrow-right-circle"></i> Assign
        </button>
      <% } %>
      <% if (perms.can_rename) { %>
        <button class="btn btn-sm btn-outline-info bulk-action-trigger" data-action="rename"
                data-bs-toggle="modal" data-bs-target="#bulkActionModal">
          <i class="bi bi-pencil"></i> Rename
        </button>
      <% } %>
      <% if (perms.can_makeover) { %>
        <button class="btn btn-sm btn-outline-success bulk-action-trigger" data-action="makeover"
                data-bs-toggle="modal" data-bs-target="#bulkActionModal">
          <i class="bi bi-brush"></i> Makeover
        </button>
      <% } %>
      <% if (perms.can_tag) { %>
        <button class="btn btn-sm btn-outline-light bulk-action-trigger" data-action="tag"
                data-bs-toggle="modal" data-bs-target="#bulkActionModal">
          <i class="bi bi-tag"></i> Tag
        </button>
      <% } %>
      <button class="btn btn-sm btn-outline-secondary" id="bulk-deselect">
        <i class="bi bi-x-lg"></i> Clear
      </button>
    </div>
  </div>
</div>

<!-- Bulk Action Modal -->
<div class="modal fade" id="bulkActionModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content bg-dark border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title" id="bulkActionTitle">Bulk Action</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/my/groups/<%= group.id %>/bulk-actions">
        <div class="modal-body">
          <input type="hidden" name="action" id="bulk-action-type">
          <input type="hidden" name="items" id="bulk-action-items">
          <p class="text-muted">Applying to <strong id="bulk-modal-count">0</strong> selected items</p>

          <div id="bulk-assign-fields" style="display:none;">
            <div class="mb-3">
              <label class="form-label">Assignment Type</label>
              <select name="assign_type" class="form-select bg-dark text-light border-secondary">
                <option value="commander">Commander</option>
                <option value="pilot">Pilot</option>
                <option value="operator">Operator</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Character or Faction Name / UID</label>
              <input type="text" class="form-control bg-dark text-light border-secondary"
                     name="assign_to" placeholder="e.g., Roger Harp or 1:12345">
            </div>
          </div>

          <div id="bulk-rename-fields" style="display:none;">
            <div class="mb-3">
              <label class="form-label">New Name</label>
              <input type="text" class="form-control bg-dark text-light border-secondary"
                     name="new_name" placeholder="Enter new name...">
            </div>
          </div>

          <div id="bulk-makeover-fields" style="display:none;">
            <div class="mb-3">
              <label class="form-label">New Owner (Character or Faction Name / UID)</label>
              <input type="text" class="form-control bg-dark text-light border-secondary"
                     name="new_owner" placeholder="e.g., Rendili StarDrive or 20:502">
            </div>
          </div>

          <div id="bulk-tag-fields" style="display:none;">
            <div class="mb-3">
              <label class="form-label">Tag</label>
              <input type="text" class="form-control bg-dark text-light border-secondary"
                     name="tag_value" placeholder="Enter tag name...">
            </div>
            <div class="mb-3">
              <label class="form-label">Operation</label>
              <select name="tag_action" class="form-select bg-dark text-light border-secondary">
                <option value="add">Add Tag</option>
                <option value="remove">Remove Tag</option>
              </select>
            </div>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-info">Execute on All</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Single Action Modal -->
<div class="modal fade" id="actionModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content bg-dark border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title" id="actionModalTitle">Action</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/my/groups/<%= group.id %>/actions">
        <div class="modal-body">
          <input type="hidden" name="action" id="action-type">
          <input type="hidden" name="entity_type" id="action-entity-type">
          <input type="hidden" name="entity_uid" id="action-entity-uid">
          <p>Entity: <strong id="action-entity-label"></strong></p>

          <!-- Assign fields -->
          <div id="assign-fields" style="display:none;">
            <div class="mb-3">
              <label class="form-label">Assignment Type</label>
              <select name="assign_type" class="form-select bg-dark text-light border-secondary">
                <option value="commander">Commander</option>
                <option value="pilot">Pilot</option>
                <option value="operator">Operator</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Character or Faction Name / UID</label>
              <input type="text" class="form-control bg-dark text-light border-secondary"
                     name="assign_to" placeholder="e.g., Roger Harp or 1:12345">
            </div>
          </div>

          <!-- Rename fields -->
          <div id="rename-fields" style="display:none;">
            <div class="mb-3">
              <label class="form-label">New Name</label>
              <input type="text" class="form-control bg-dark text-light border-secondary"
                     name="new_name" placeholder="Enter new name...">
            </div>
          </div>

          <!-- Makeover fields -->
          <div id="makeover-fields" style="display:none;">
            <div class="mb-3">
              <label class="form-label">New Owner (Character or Faction Name / UID)</label>
              <input type="text" class="form-control bg-dark text-light border-secondary"
                     name="new_owner" placeholder="e.g., Rendili StarDrive or 20:502">
            </div>
          </div>

          <!-- Tag fields -->
          <div id="tag-fields" style="display:none;">
            <div class="mb-3">
              <label class="form-label">Tag</label>
              <input type="text" class="form-control bg-dark text-light border-secondary"
                     name="tag_value" placeholder="Enter tag name...">
            </div>
            <div class="mb-3">
              <label class="form-label">Operation</label>
              <select name="tag_action" class="form-select bg-dark text-light border-secondary">
                <option value="add">Add Tag</option>
                <option value="remove">Remove Tag</option>
              </select>
            </div>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-info">Execute</button>
        </div>
      </form>
    </div>
  </div>
</div>
