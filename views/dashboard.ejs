<h2 class="mb-4"><i class="bi bi-speedometer2 text-info"></i> Leader Dashboard</h2>

<div class="card bg-dark border-secondary mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-building text-info"></i> Inventory Owners</span>
    <button class="btn btn-sm btn-outline-info" type="button" data-bs-toggle="collapse" data-bs-target="#ownerForm">
      <i class="bi bi-gear"></i> Configure
    </button>
  </div>
  <div class="card-body">
    <% if (owners.length > 0) { %>
      <div class="d-flex flex-wrap gap-2">
        <% owners.forEach(o => { %>
          <span class="badge bg-info text-dark">
            <%= o.name %>
            <span class="badge bg-dark text-muted ms-1"><%= o.owner_type %></span>
          </span>
        <% }) %>
      </div>
    <% } else { %>
      <p class="mb-0 text-warning">No owners configured. Click Configure to enable factions.</p>
    <% } %>
  </div>
  <div class="collapse" id="ownerForm">
    <div class="card-body border-top border-secondary">
      <% if (factions.length > 0) { %>
        <form method="POST" action="/dashboard/owners">
          <p class="text-muted small mb-2">Select which factions to include in inventory management:</p>
          <% factions.forEach(f => { %>
            <div class="form-check mb-1">
              <input class="form-check-input" type="checkbox" name="owner_uids" value="<%= f.uid %>"
                     id="owner-<%= f.uid %>" <%= enabledSet.has(f.uid) ? 'checked' : '' %>>
              <label class="form-check-label" for="owner-<%= f.uid %>">
                <%= f.name %> <span class="text-muted small">(<%= f.uid %>)</span>
                <% if (f.primary) { %><span class="badge bg-info text-dark ms-1">Primary</span><% } %>
              </label>
            </div>
          <% }) %>
          <button type="submit" class="btn btn-sm btn-info mt-2">Save Owners</button>
        </form>
      <% } else { %>
        <p class="text-muted small mb-0">Could not load faction list. Ensure the leader is authenticated.</p>
      <% } %>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card bg-dark border-secondary">
      <div class="card-body text-center">
        <h3 class="text-info mb-0"><%= summary.totalItems %></h3>
        <small class="text-muted">Cached Inventory Items</small>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card bg-dark border-secondary">
      <div class="card-body text-center">
        <h3 class="text-info mb-0"><%= summary.totalGroups %></h3>
        <small class="text-muted">Virtual Groups</small>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card bg-dark border-secondary">
      <div class="card-body text-center">
        <h3 class="text-info mb-0"><%= summary.totalUsers %></h3>
        <small class="text-muted">Sub-users</small>
      </div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-md-8">
    <div class="card bg-dark border-secondary">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>Inventory Cache Status</span>
        <form method="POST" action="/inventory/refresh" class="d-inline">
          <button type="submit" class="btn btn-sm btn-outline-info">
            <i class="bi bi-arrow-clockwise"></i> Refresh All
          </button>
        </form>
      </div>
      <div class="card-body p-0">
        <% if (owners.length === 0) { %>
          <div class="text-center text-muted py-3">No owners configured yet. Click Configure above to enable factions.</div>
        <% } else { %>
          <table class="table table-dark table-hover mb-0">
            <thead>
              <tr><th>Owner</th><th>Type</th><th class="text-end">Items</th><th class="text-end">Last Updated</th></tr>
            </thead>
            <tbody>
              <% owners.forEach(o => { %>
                <% const info = ownerMap[o.uid] || { items: 0, lastCached: null }; %>
                <tr>
                  <td class="text-info"><%= o.name %></td>
                  <td><span class="badge bg-secondary text-capitalize"><%= o.owner_type %></span></td>
                  <td class="text-end"><%= info.items %></td>
                  <td class="text-end text-muted small">
                    <%= info.lastCached ? info.lastCached.toLocaleString() : 'Never' %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card bg-dark border-secondary">
      <div class="card-header">Quick Actions</div>
      <div class="list-group list-group-flush">
        <a href="/groups" class="list-group-item list-group-item-action bg-dark text-light border-secondary">
          <i class="bi bi-collection text-info"></i> Manage Groups
        </a>
        <a href="/inventory" class="list-group-item list-group-item-action bg-dark text-light border-secondary">
          <i class="bi bi-archive text-info"></i> Browse Inventory
        </a>
        <a href="/users" class="list-group-item list-group-item-action bg-dark text-light border-secondary">
          <i class="bi bi-people text-info"></i> Manage Users
        </a>
        <a href="/audit" class="list-group-item list-group-item-action bg-dark text-light border-secondary">
          <i class="bi bi-journal-text text-info"></i> View Audit Log
        </a>
      </div>
    </div>
  </div>
</div>
