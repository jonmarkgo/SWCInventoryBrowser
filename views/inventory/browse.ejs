<div class="d-flex justify-content-between align-items-center mb-3">
  <h2><i class="bi bi-archive text-info"></i> Inventory Browser</h2>
  <form method="POST" action="/inventory/refresh" class="d-inline">
    <input type="hidden" name="type" value="<%= currentType %>">
    <button type="submit" class="btn btn-sm btn-outline-info">
      <i class="bi bi-arrow-clockwise"></i> Refresh from API
    </button>
  </form>
</div>

<!-- Entity type tabs -->
<ul class="nav nav-pills mb-3 flex-wrap gap-1">
  <% entityTypes.forEach(t => { %>
    <li class="nav-item">
      <a class="nav-link text-capitalize <%= t === currentType ? 'active bg-info text-dark' : 'text-light' %>"
         href="/inventory/<%= t %>">
        <%= t %>
      </a>
    </li>
  <% }) %>
</ul>

<!-- Search + Owner Filter -->
<form method="GET" action="/inventory/<%= currentType %>" class="mb-3">
  <div class="d-flex gap-2 flex-wrap align-items-end">
    <div class="input-group input-group-sm" style="max-width: 400px;">
      <input type="text" name="search" class="form-control bg-dark text-light border-secondary"
             placeholder="Search by name..." value="<%= search %>">
      <button class="btn btn-outline-info" type="submit"><i class="bi bi-search"></i></button>
      <% if (search || ownerFilter) { %>
        <a href="/inventory/<%= currentType %>" class="btn btn-outline-secondary">Clear</a>
      <% } %>
    </div>
    <% if (owners.length > 1) { %>
      <select name="owner" class="form-select form-select-sm bg-dark text-light border-secondary" style="max-width: 250px;" onchange="this.form.submit()">
        <option value="">All Owners</option>
        <% owners.forEach(o => { %>
          <option value="<%= o.uid %>" <%= ownerFilter === o.uid ? 'selected' : '' %>><%= o.name %></option>
        <% }) %>
      </select>
    <% } %>
  </div>
</form>

<% if (cacheAge) { %>
  <p class="text-muted small mb-2">
    Cache last updated: <%= cacheAge.toLocaleString() %> &mdash;
    <span class="text-secondary"><%= total %> items total</span>
  </p>
<% } %>

<% if (items.length === 0) { %>
  <div class="text-center text-muted py-5">
    <i class="bi bi-inbox display-4"></i>
    <p class="mt-2">No <%= currentType %> found. Try refreshing from the API.</p>
  </div>
<% } else { %>
  <div class="table-responsive">
    <table class="table table-dark table-hover align-middle" id="browse-table">
      <thead>
        <tr>
          <th style="width:40px;">
            <input type="checkbox" class="form-check-input" id="select-all-browse">
          </th>
          <th style="width: 50px;"></th>
          <th>Name</th>
          <th>UID</th>
          <% if (owners.length > 1) { %><th>Owner</th><% } %>
          <th>Groups</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(item => { %>
          <tr>
            <td>
              <input type="checkbox" class="form-check-input bulk-select"
                     data-entity-type="<%= item.entity_type %>"
                     data-entity-uid="<%= item.entity_uid %>"
                     data-entity-name="<%= item.entity_name %>">
            </td>
            <td>
              <% if (item.entity_image) { %>
                <img src="<%= item.entity_image %>" alt="" class="rounded" style="width:36px; height:36px; object-fit:cover;">
              <% } else { %>
                <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                  <i class="bi bi-box text-muted"></i>
                </div>
              <% } %>
            </td>
            <td>
              <a href="/inventory/<%= currentType %>/<%= item.entity_uid %>" class="text-info text-decoration-none">
                <%= item.entity_name || 'Unnamed' %>
              </a>
            </td>
            <td class="text-muted small"><%= item.entity_uid %></td>
            <% if (owners.length > 1) { %>
              <td class="small"><%= ownerMap[item.owner_uid] || item.owner_uid %></td>
            <% } %>
            <td>
              <% const itemGroups = groupMap[item.entity_type + ':' + item.entity_uid] || []; %>
              <% itemGroups.forEach(g => { %>
                <span class="badge bg-secondary"><%= g.name %></span>
              <% }) %>
            </td>
            <td class="text-end">
              <button class="btn btn-sm btn-outline-info add-to-group-btn"
                      data-entity-type="<%= item.entity_type %>"
                      data-entity-uid="<%= item.entity_uid %>"
                      data-entity-name="<%= item.entity_name %>"
                      data-entity-image="<%= item.entity_image %>"
                      data-bs-toggle="modal" data-bs-target="#addToGroupModal">
                <i class="bi bi-plus-circle"></i> Group
              </button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <%- include('../partials/pagination', { page, pages, query: { search, type: currentType, owner: ownerFilter } }) %>
<% } %>

<!-- Bulk Action Bar -->
<div class="bulk-action-bar" id="bulk-action-bar" style="display:none;">
  <div class="container-fluid d-flex align-items-center justify-content-between">
    <span><strong id="bulk-count">0</strong> items selected</span>
    <div class="d-flex gap-2">
      <button class="btn btn-sm btn-outline-info bulk-action-trigger" data-action="add-to-group"
              data-bs-toggle="modal" data-bs-target="#bulkAddToGroupModal">
        <i class="bi bi-plus-circle"></i> Add to Group
      </button>
      <button class="btn btn-sm btn-outline-warning bulk-action-trigger" data-action="assign"
              data-bs-toggle="modal" data-bs-target="#bulkActionModal">
        <i class="bi bi-arrow-right-circle"></i> Assign
      </button>
      <button class="btn btn-sm btn-outline-info bulk-action-trigger" data-action="rename"
              data-bs-toggle="modal" data-bs-target="#bulkActionModal">
        <i class="bi bi-pencil"></i> Rename
      </button>
      <button class="btn btn-sm btn-outline-success bulk-action-trigger" data-action="makeover"
              data-bs-toggle="modal" data-bs-target="#bulkActionModal">
        <i class="bi bi-brush"></i> Makeover
      </button>
      <button class="btn btn-sm btn-outline-light bulk-action-trigger" data-action="tag"
              data-bs-toggle="modal" data-bs-target="#bulkActionModal">
        <i class="bi bi-tag"></i> Tag
      </button>
      <button class="btn btn-sm btn-outline-secondary" id="bulk-deselect">
        <i class="bi bi-x-lg"></i> Clear
      </button>
    </div>
  </div>
</div>

<!-- Bulk Action Modal -->
<div class="modal fade" id="bulkActionModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content bg-dark border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title" id="bulkActionTitle">Bulk Action</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/inventory/bulk-action">
        <div class="modal-body">
          <input type="hidden" name="action" id="bulk-action-type">
          <input type="hidden" name="items" id="bulk-action-items">
          <p class="text-muted">Applying to <strong id="bulk-modal-count">0</strong> selected items</p>

          <div id="bulk-assign-fields" style="display:none;">
            <div class="mb-3">
              <label class="form-label">Assignment Type</label>
              <select name="assign_type" class="form-select bg-dark text-light border-secondary">
                <option value="commander">Commander</option>
                <option value="pilot">Pilot</option>
                <option value="operator">Operator</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Character or Faction Name / UID</label>
              <input type="text" class="form-control bg-dark text-light border-secondary"
                     name="assign_to" placeholder="e.g., Roger Harp or 1:12345">
            </div>
          </div>

          <div id="bulk-rename-fields" style="display:none;">
            <div class="mb-3">
              <label class="form-label">New Name</label>
              <input type="text" class="form-control bg-dark text-light border-secondary"
                     name="new_name" placeholder="Enter new name...">
            </div>
          </div>

          <div id="bulk-makeover-fields" style="display:none;">
            <div class="mb-3">
              <label class="form-label">New Owner (Character or Faction Name / UID)</label>
              <input type="text" class="form-control bg-dark text-light border-secondary"
                     name="new_owner" placeholder="e.g., Rendili StarDrive or 20:502">
            </div>
          </div>

          <div id="bulk-tag-fields" style="display:none;">
            <div class="mb-3">
              <label class="form-label">Tag</label>
              <input type="text" class="form-control bg-dark text-light border-secondary"
                     name="tag_value" placeholder="Enter tag name...">
            </div>
            <div class="mb-3">
              <label class="form-label">Operation</label>
              <select name="tag_action" class="form-select bg-dark text-light border-secondary">
                <option value="add">Add Tag</option>
                <option value="remove">Remove Tag</option>
              </select>
            </div>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-info">Execute on All</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Bulk Add to Group Modal -->
<div class="modal fade" id="bulkAddToGroupModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content bg-dark border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title">Add to Group</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/inventory/bulk-add-to-group">
        <div class="modal-body">
          <input type="hidden" name="items" id="bulk-group-items">
          <p class="text-muted">Adding <strong id="bulk-group-count">0</strong> items to group</p>
          <select name="group_id" class="form-select bg-dark text-light border-secondary" required>
            <option value="">Select a group...</option>
            <% groups.forEach(g => { %>
              <option value="<%= g.id %>"><%= g.name %></option>
            <% }) %>
          </select>
          <% if (groups.length === 0) { %>
            <p class="text-muted small mt-2">No groups yet. <a href="/groups" class="text-info">Create one first.</a></p>
          <% } %>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-info" <%= groups.length === 0 ? 'disabled' : '' %>>Add to Group</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Single Add to Group Modal -->
<div class="modal fade" id="addToGroupModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content bg-dark border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title">Add to Group</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form id="addToGroupForm" method="POST">
        <div class="modal-body">
          <input type="hidden" name="entity_type" id="modal-entity-type">
          <input type="hidden" name="entity_uid" id="modal-entity-uid">
          <input type="hidden" name="entity_name" id="modal-entity-name">
          <input type="hidden" name="entity_image" id="modal-entity-image">
          <p class="mb-2">Adding: <strong id="modal-item-label"></strong></p>
          <select name="group_id" class="form-select bg-dark text-light border-secondary" required>
            <option value="">Select a group...</option>
            <% groups.forEach(g => { %>
              <option value="<%= g.id %>"><%= g.name %></option>
            <% }) %>
          </select>
          <% if (groups.length === 0) { %>
            <p class="text-muted small mt-2">No groups yet. <a href="/groups" class="text-info">Create one first.</a></p>
          <% } %>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-info" <%= groups.length === 0 ? 'disabled' : '' %>>Add to Group</button>
        </div>
      </form>
    </div>
  </div>
</div>
